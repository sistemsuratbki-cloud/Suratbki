# =========================================================================
# Hostinger LiteSpeed & Apache Configuration for BKI Pontianak (React SPA)
# Hostinger public_html Configuration
# =========================================================================

# 1. Prevent LiteSpeed 408 Connection Time-out & Premature Aborts
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .* - [E=noconntimeout:1,E=noabort:1]
</IfModule>

# 2. Directory Index
DirectoryIndex index.html index.php

# 3. URL Rewriting for React SPA
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward Authorization and custom headers to PHP environment (Crucial for FastCGI / LiteSpeed)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_API_TOKEN:%{HTTP:X-API-Token}]

  # Stop loop if already targeting index.html
  RewriteRule ^index\.html$ - [L]

  # Exclude /api directory so PHP API is never touched by SPA routing
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule ^ - [L]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other frontend requests to /index.html for React client-side routing
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Cache Control for Static Assets (Vite bundled assets have hashes)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & JSON must NEVER be cached so updates appear immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images and Icons
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>
