# =========================================================================
# Hostinger LiteSpeed & Apache — BKI Pontianak (Root public_html)
# STATIC SPA serving from dist/ — NO PHP router needed
# =========================================================================

# 1. Prevent LiteSpeed 408 Timeouts & Premature Aborts
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .* - [E=noconntimeout:1,E=noabort:1]
</IfModule>

# 2. Default document
DirectoryIndex dist/index.html index.html

# 3. URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward auth headers to PHP environment (LiteSpeed/FastCGI strips them)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_API_TOKEN:%{HTTP:X-API-Token}]

  # ── STOP conditions (no further processing) ──

  # API requests → let api/.htaccess handle
  RewriteRule ^api/ - [L]

  # Health check
  RewriteRule ^health\.php$ - [L]

  # Already dist/index.html → stop (prevent loop)
  RewriteRule ^dist/index\.html$ - [L]

  # Existing files in root (favicon, logos, etc.) → serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ── Map virtual paths to dist/ ──

  # Files that exist inside dist/ → serve them from dist/
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.+)$ dist/$1 [L]

  # ── SPA Fallback ──
  # All remaining routes → dist/index.html (React client-side routing)
  RewriteRule ^ dist/index.html [L]
</IfModule>

# 4. Block sensitive files
<FilesMatch "^(\.(git|env|htpasswd)|config\.php|package(-lock)?\.json|vite\.config\.js|index\.php)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Cache Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 7. GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
