# =========================================================================
# Hostinger LiteSpeed & Apache — BKI Pontianak (Root public_html)
# Bulletproof SPA Routing from dist/ with Zero Rewrite Loops
# =========================================================================

# 1. Prevent LiteSpeed Timeouts & Aborts
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .* - [E=noconntimeout:1,E=noabort:1]
</IfModule>

# 2. DirectoryIndex — serve React SPA from dist/index.html
DirectoryIndex dist/index.html index.html index.php

# 3. URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward auth headers to PHP (LiteSpeed FastCGI)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_API_TOKEN:%{HTTP:X-API-Token}]

  # CRITICAL: Stop if request has already been internally rewritten (prevents 408 loops)
  RewriteCond %{ENV:REDIRECT_STATUS} 200
  RewriteRule ^ - [L]

  # ── Direct API requests → pass to api/ ──
  RewriteRule ^api/ - [L]

  # ── Requests already in dist/ → pass directly without rewrite ──
  RewriteRule ^dist/ - [L]

  # ── Never serve uncompiled root index.html or raw index.php → map to dist/index.html ──
  RewriteRule ^index\.(html|php)$ dist/index.html [L]

  # ── Existing real files in root (health.php, favicon.ico, etc.) → serve directly ──
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ── Static assets that exist in dist/ (assets/, signatures/, svg, etc.) ──
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # ── SPA Fallback: all remaining routes (/, /login, /dashboard, etc.) ──
  RewriteRule ^ dist/index.html [L]
</IfModule>

# 4. Block sensitive files
<FilesMatch "^(\.(git|env|htpasswd)|config\.php|setup\.php|package(-lock)?\.json|vite\.config\.js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Cache Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 7. GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
