# =========================================================================
# Hostinger LiteSpeed & Apache — BKI Pontianak (Root public_html)
# Serve React SPA from dist/
# =========================================================================

# 1. Prevent LiteSpeed 408 Timeouts
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .* - [E=noconntimeout:1,E=noabort:1]
</IfModule>

# 2. Custom Error Document — catch CDN 408 and redirect to SPA
ErrorDocument 408 /dist/index.html

# 3. DirectoryIndex — app.php serves dist/index.html via PHP (bypasses CDN cache)
DirectoryIndex app.php dist/index.html index.html

# 4. Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward auth headers to PHP (LiteSpeed/FastCGI strips them)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_API_TOKEN:%{HTTP:X-API-Token}]

  # ── STOP: API requests → let api/.htaccess handle ──
  RewriteRule ^api/ - [L]

  # ── STOP: PHP files (health, etc.) ──
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ── STOP: anything already in dist/ (prevent loop) ──
  RewriteRule ^dist/ - [L]

  # ── ROOT "/" request → serve dist/index.html ──
  RewriteRule ^$ dist/index.html [L]

  # ── Redirect root index.html to dist version ──
  RewriteRule ^index\.html$ dist/index.html [L]

  # ── Redirect root index.php to dist version ──
  RewriteRule ^index\.php$ dist/index.html [L]

  # ── Files that exist inside dist/ → proxy to dist/ ──
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.+)$ dist/$1 [L]

  # ── Existing files in root → serve directly ──
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ── SPA Fallback: all other routes → dist/index.html ──
  RewriteRule ^ dist/index.html [L]
</IfModule>

# 4. Block sensitive files
<FilesMatch "^(\.(git|env|htpasswd)|config\.php|setup\.php|package(-lock)?\.json|vite\.config\.js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Cache Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 7. GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
