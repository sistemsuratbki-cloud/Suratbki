# =========================================================================
# Hostinger LiteSpeed & Apache — BKI Pontianak (Root public_html)
# Serve React SPA from dist/ — NO PHP router
# =========================================================================

# 1. Prevent LiteSpeed 408 Timeouts
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .* - [E=noconntimeout:1,E=noabort:1]
</IfModule>

# 2. Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward auth headers to PHP (LiteSpeed/FastCGI strips them)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_API_TOKEN:%{HTTP:X-API-Token}]

  # ── STOP: API requests → let api/.htaccess handle ──
  RewriteRule ^api/ - [L]

  # ── STOP: health check ──
  RewriteRule ^health\.php$ - [L]

  # ── STOP: prevent loop on dist/ internal access ──
  RewriteRule ^dist/ - [L]

  # ── ROOT "/" request → rewrite to dist/index.html ──
  RewriteRule ^$ dist/index.html [L]

  # ── Files that exist inside dist/ → proxy to dist/ ──
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.+)$ dist/$1 [L]

  # ── Existing files in root (NOT index.html/index.php) → serve directly ──
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !^/index\.(html|php)$ [NC]
  RewriteRule ^ - [L]

  # ── SPA Fallback: all other routes → dist/index.html ──
  RewriteRule ^ dist/index.html [L]
</IfModule>

# 3. Block sensitive files from direct browser access
<FilesMatch "^(\.(git|env|htpasswd)|config\.php|package(-lock)?\.json|vite\.config\.js|index\.(php|html))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# 4. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Cache Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 6. GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
