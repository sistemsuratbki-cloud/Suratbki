# =========================================================================
# Hostinger LiteSpeed & Apache — BKI Pontianak (Root public_html)
# MINIMAL CONFIG — semua routing lewat index.php, TANPA SPA rewrite
# =========================================================================

# 1. Prevent LiteSpeed 408 Timeouts & Premature Aborts
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .* - [E=noconntimeout:1,E=noabort:1]
</IfModule>

# 2. Default document: index.php handles EVERYTHING
DirectoryIndex index.php

# 3. URL Rewriting — MINIMAL, hanya forward headers + route ke index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward auth headers to PHP environment (LiteSpeed/FastCGI strips them)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_API_TOKEN:%{HTTP:X-API-Token}]

  # STOP: index.php itself — prevent loop
  RewriteRule ^index\.php$ - [L]

  # STOP: Direct API access — let api/.htaccess handle it
  RewriteRule ^api/ - [L]

  # STOP: Existing real files (assets, images, fonts, etc.) — serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # STOP: Files inside dist/ that exist physically
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.+)$ dist/$1 [L]

  # EVERYTHING ELSE → index.php (PHP router, no more .htaccess loops)
  RewriteRule ^ index.php [L]
</IfModule>

# 4. Block sensitive files
<FilesMatch "^(\.(git|env|htpasswd)|config\.php|package(-lock)?\.json|vite\.config\.js)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Cache Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>
